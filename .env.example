# Copy to .env for local development (.env is gitignored).

# Used by docker-compose to initialise Postgres
POSTGRES_USER=usage
POSTGRES_PASSWORD=usage
POSTGRES_DB=usage_metering

# Must match the POSTGRES_* values above
DATABASE_URL=postgres://usage:usage@localhost:5432/usage_metering
REDIS_URL=redis://localhost:6379

API_PORT=3000
API_HOST=0.0.0.0
# Required. Clients send it in the x-api-key header. Use at least 16 random characters.
API_KEY=change-me-to-a-long-random-string
# Optional
# API_BODY_LIMIT_BYTES=16384
# LOG_LEVEL=info
