{
  "name": "@usage-metering/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --conditions=development --env-file-if-exists=../.env src/index.ts",
    "start": "node dist/index.js",
    "dev:subscriber": "tsx watch --conditions=development --env-file-if-exists=../.env src/subscriber.ts",
    "start:subscriber": "node dist/subscriber.js"
  },
  "dependencies": {
    "@usage-metering/shared": "*",
    "bullmq": "^6.5.4",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
